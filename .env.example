# Copie para .env e preencha com valores reais. NÃO versione o .env.

# PostgreSQL (Neon) — pooled, usado em runtime pela aplicação (driver adapter)
DATABASE_URL=""

# PostgreSQL (Neon) — conexão direta (não-pooled), usada nas migrations (Prisma CLI)
DIRECT_URL=""

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# URL base da aplicação (ex.: http://localhost:3000 em dev)
AUTH_URL="http://localhost:3000"

# Assistente — OpenAI. Sem esta chave o assistente responde apenas as perguntas
# pré-calculadas sobre os dados do exercício (não quebra, só não conversa).
OPENAI_API_KEY=""
# Modelo usado pelo assistente (padrão: gpt-4o-mini)
OPENAI_MODEL=""

# Acesso rápido de demonstração na tela de login. Use "false" para esconder.
DEMO_LOGIN=""
