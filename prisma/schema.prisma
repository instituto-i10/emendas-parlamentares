// Sistema de Gestão de Emendas Parlamentares — modelo de domínio.
// Orçamento público municipal brasileiro (PPA/LDO/LOA), separado por Poder.
//
// Princípios estruturais (PROMPT 1):
//  - Toda classificação orçamentária é por FK — NUNCA string solta para
//    programa, ação, órgão, unidade, natureza ou fonte.
//  - IDs cuid, createdAt/updatedAt e índices adequados.
//  - Auth.js (User/Account/Session/VerificationToken) em inglês por exigência do
//    adapter; domínio em português. FKs para o usuário usam `usuarioId`.
//
// Prisma 7 usa driver adapters: a URL de conexão vem do prisma.config.ts (CLI /
// migrations, via DIRECT_URL) e de src/lib/prisma.ts (runtime, via DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

// Poder da separação institucional.
enum Poder {
  LEGISLATIVO
  EXECUTIVO
}

// Resultado da análise de viabilidade técnica feita pelo Executivo.
// Registro informativo: não altera a emenda nem trava a tramitação.
enum ResultadoViabilidade {
  VIAVEL
  VIAVEL_COM_RESSALVA
  INVIAVEL
}

// Etapas da despesa pública brasileira (Lei 4.320/1964, arts. 58 a 65).
// Vocabulário padrão para que uma futura integração com o sistema financeiro
// do município encontre os campos já prontos.
enum EtapaExecucao {
  EMPENHO
  LIQUIDACAO
  PAGAMENTO
}

// Situação do exercício orçamentário (motor exige exercício ABERTO).
enum StatusExercicio {
  ABERTO
  ENCERRADO
}

// Instrumentos de planejamento fiscal.
enum TipoInstrumento {
  PPA
  LDO
  LOA
}

// Espécie do instrumento: projeto de lei (base das emendas) ou lei aprovada.
enum EspecieInstrumento {
  PROJETO_LEI
  LEI_APROVADA
}

// Ciclo de vida do instrumento (PROJETO_LEI → ... → VIGENTE).
enum StatusInstrumento {
  EM_ELABORACAO
  ENVIADO
  EM_TRAMITACAO
  APROVADO
  SANCIONADO
  VIGENTE
  ENCERRADO
}

// Tipo de ação orçamentária (classificação funcional-programática).
enum TipoAcao {
  PROJETO
  ATIVIDADE
  OPERACAO_ESPECIAL
}

// Documentos normativos de referência.
enum TipoNorma {
  LOM
  REGIMENTO_INTERNO
  OUTRO
}

// Escopo de um parâmetro de validação.
enum EscopoParametro {
  GERAL
  EXERCICIO
}

// Modo de aplicação de um parâmetro: impede (BLOQUEANTE) ou apenas avisa.
enum ModoValidacao {
  BLOQUEANTE
  ALERTA
}

// Natureza do beneficiário final da emenda (rastreabilidade ponta a ponta —
// exigência STF/TCE; ver docs/analise-regulatoria-gaps.md).
// Categorias pedidas pelo jurídico do cliente. Não é rótulo: a categoria define
// o RITO. Terceiro setor exige plano de trabalho completo (justificativa,
// objetivo, declaração e planilha); administração direta e indireta exigem só a
// justificativa.
enum TipoBeneficiario {
  ADMINISTRACAO_DIRETA
  ADMINISTRACAO_INDIRETA
  TERCEIRO_SETOR
}

// Tipo de emenda parlamentar.
enum TipoEmenda {
  ACRESCIMO
  ANULACAO
  REMANEJAMENTO
  IMPOSITIVA
}

// Ciclo de vida da emenda.
enum StatusEmenda {
  RASCUNHO
  EM_VALIDACAO
  VALIDA
  INVALIDA
  SUBMETIDA
  EM_TRAMITACAO
  APROVADA
  REJEITADA
}

// Resultado consolidado de uma execução de validação.
enum ResultadoValidacao {
  VALIDA
  INVALIDA
}

// ============================================================================
// PLANEJAMENTO — contexto anual e classificação orçamentária (tudo por FK)
// ============================================================================

// Exercício orçamentário (ano). Contexto de dados de toda a aplicação.
model Exercicio {
  id        String          @id @default(cuid())
  ano       Int             @unique
  status    StatusExercicio @default(ABERTO)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Classificação e demais entidades vinculadas ao exercício.
  orgaos       Orgao[]
  unidades     UnidadeOrcamentaria[]
  funcoes      Funcao[]
  subfuncoes   Subfuncao[]
  programas    Programa[]
  acoes        Acao[]
  naturezas    NaturezaDespesa[]
  fontes       FonteRecurso[]
  prioridades  PrioridadeLDO[]
  instrumentos InstrumentoPlanejamento[]
  dotacoes     Dotacao[]
  emendas      Emenda[]
  parametros   ParametroValidacao[]
}

// Órgão orçamentário.
model Orgao {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercicio Exercicio             @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  unidades  UnidadeOrcamentaria[]
  dotacoes  Dotacao[]

  @@unique([exercicioId, codigo])
  @@index([exercicioId])
}

// Unidade Orçamentária (pertence a um Órgão).
model UnidadeOrcamentaria {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  orgaoId     String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orgao     Orgao     @relation(fields: [orgaoId], references: [id], onDelete: Cascade)
  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes  Dotacao[]

  @@unique([exercicioId, orgaoId, codigo])
  @@index([orgaoId])
  @@index([exercicioId])
}

// Função (classificação funcional).
model Funcao {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercicio  Exercicio   @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  subfuncoes Subfuncao[]
  dotacoes   Dotacao[]

  @@unique([exercicioId, codigo])
  @@index([exercicioId])
}

// Subfunção (pertence a uma Função).
model Subfuncao {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  funcaoId    String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  funcao    Funcao    @relation(fields: [funcaoId], references: [id], onDelete: Cascade)
  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes  Dotacao[]

  @@unique([exercicioId, funcaoId, codigo])
  @@index([funcaoId])
  @@index([exercicioId])
}

// Programa (classificação programática; deve constar no PPA do exercício).
model Programa {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  // Consta do PPA vigente? É a base da checagem PROGRAMA_NO_PPA (LOM art. 140
  // §1º, I). Não dá para derivar isso de dotações: PPA não tem dotação — tem
  // programas, ações e metas plurianuais. Preenchido a partir do Anexo II do
  // PPA (ver docs/better/dados/ppa-2026-2029-programas.json).
  constaNoPPA Boolean  @default(false)
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercicio   Exercicio       @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  acoes       Acao[]
  dotacoes    Dotacao[]
  prioridades PrioridadeLDO[]

  @@unique([exercicioId, codigo])
  @@index([exercicioId])
}

// Ação (pertence a um Programa; projeto/atividade/operação especial).
model Acao {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  tipo        TipoAcao
  programaId  String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programa    Programa        @relation(fields: [programaId], references: [id], onDelete: Cascade)
  exercicio   Exercicio       @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes    Dotacao[]
  prioridades PrioridadeLDO[]

  @@unique([exercicioId, programaId, codigo])
  @@index([programaId])
  @@index([exercicioId])
}

// Natureza da Despesa (categoria econômica → grupo → modalidade → elemento).
// Os componentes são atributos da própria entidade; a referência a ela é por FK.
model NaturezaDespesa {
  id                  String   @id @default(cuid())
  codigo              String
  categoriaEconomica  String
  grupo               String
  modalidadeAplicacao String
  // `elemento` guarda o CÓDIGO do elemento ("30", "11"); `nome` guarda o rótulo
  // por extenso ("Material de Consumo"). Sem o nome, o vereador só via o código
  // na hora de escolher a dotação — apontamento do jurídico do cliente.
  elemento            String
  nome                String?
  exercicioId         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes  Dotacao[]

  @@unique([exercicioId, codigo])
  @@index([exercicioId])
}

// Fonte de Recurso.
model FonteRecurso {
  id          String   @id @default(cuid())
  codigo      String
  nome        String
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  dotacoes  Dotacao[]

  @@unique([exercicioId, codigo])
  @@index([exercicioId])
}

// Prioridade/meta da LDO (usada na checagem ADERENCIA_LDO do motor).
model PrioridadeLDO {
  id          String   @id @default(cuid())
  descricao   String
  programaId  String
  acaoId      String?
  exercicioId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programa  Programa  @relation(fields: [programaId], references: [id], onDelete: Cascade)
  acao      Acao?     @relation(fields: [acaoId], references: [id], onDelete: SetNull)
  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)

  @@index([programaId])
  @@index([acaoId])
  @@index([exercicioId])
}

// ============================================================================
// INSTRUMENTOS DE PLANEJAMENTO — base das emendas e acompanhamento
// ============================================================================

// InstrumentoPlanejamento: o PROJETO_LEI serve de base às emendas; a LEI_APROVADA
// liga-se ao PL de origem (instrumentoOrigemId) para acompanhamento.
model InstrumentoPlanejamento {
  id                  String             @id @default(cuid())
  tipo                TipoInstrumento
  especie             EspecieInstrumento
  numero              String
  ementa              String
  exercicioId         String
  status              StatusInstrumento  @default(EM_ELABORACAO)
  arquivoUrl          String?
  dataEnvio           DateTime?
  dataAprovacao       DateTime?
  dataVigencia        DateTime?
  instrumentoOrigemId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  exercicio         Exercicio                 @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  // Auto-relação: LEI_APROVADA (origem) ← PROJETO_LEI.
  instrumentoOrigem InstrumentoPlanejamento?  @relation("InstrumentoOrigem", fields: [instrumentoOrigemId], references: [id])
  derivados         InstrumentoPlanejamento[] @relation("InstrumentoOrigem")

  // A base estruturada de dotações é vinculada a UM instrumento.
  dotacoes Dotacao[]
  // Emendas apresentadas sobre este instrumento (quando é o PROJETO_LEI base).
  emendas  Emenda[]

  @@index([exercicioId])
  @@index([instrumentoOrigemId])
  @@index([exercicioId, especie, status])
}

// Dotação orçamentária: classificação completa por FK, vinculada a um instrumento.
model Dotacao {
  id                    String   @id @default(cuid())
  instrumentoId         String
  exercicioId           String
  orgaoId               String
  unidadeOrcamentariaId String
  funcaoId              String
  subfuncaoId           String
  programaId            String
  acaoId                String
  naturezaDespesaId     String
  fonteRecursoId        String
  valorInicial          Decimal  @db.Decimal(18, 2)
  valorAtual            Decimal  @db.Decimal(18, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  instrumento         InstrumentoPlanejamento @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)
  exercicio           Exercicio               @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  orgao               Orgao                   @relation(fields: [orgaoId], references: [id])
  unidadeOrcamentaria UnidadeOrcamentaria     @relation(fields: [unidadeOrcamentariaId], references: [id])
  funcao              Funcao                  @relation(fields: [funcaoId], references: [id])
  subfuncao           Subfuncao               @relation(fields: [subfuncaoId], references: [id])
  programa            Programa                @relation(fields: [programaId], references: [id])
  acao                Acao                    @relation(fields: [acaoId], references: [id])
  naturezaDespesa     NaturezaDespesa         @relation(fields: [naturezaDespesaId], references: [id])
  fonteRecurso        FonteRecurso            @relation(fields: [fonteRecursoId], references: [id])

  // Emendas que referenciam esta dotação (alvo, origem e destino de remanejamento).
  emendas        Emenda[] @relation("EmendaDotacao")
  emendasOrigem  Emenda[] @relation("EmendaDotacaoOrigem")
  emendasDestino Emenda[] @relation("EmendaDotacaoDestino")

  // Índice único da classificação completa por instrumento.
  @@unique([instrumentoId, orgaoId, unidadeOrcamentariaId, funcaoId, subfuncaoId, programaId, acaoId, naturezaDespesaId, fonteRecursoId])
  @@index([instrumentoId])
  @@index([exercicioId])
  @@index([programaId])
  @@index([acaoId])
}

// ============================================================================
// DOCUMENTOS NORMATIVOS E PARÂMETROS DE VALIDAÇÃO
// ============================================================================

// Documento normativo (LOM, Regimento Interno, outros) — repositório consultável.
model DocumentoNormativo {
  id           String    @id @default(cuid())
  tipo         TipoNorma
  titulo       String
  numero       String?
  arquivoUrl   String
  dataVigencia DateTime?
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Parâmetros que citam este documento como fundamento jurídico.
  parametros ParametroValidacao[]

  @@index([tipo])
  @@index([ativo])
}

// Parâmetro de validação (regra geral ou por exercício). Ex.: teto por autor,
// percentual impositivo, exigência de aderência à LDO. Pode citar um fundamento.
model ParametroValidacao {
  id                  String          @id @default(cuid())
  escopo              EscopoParametro @default(GERAL)
  exercicioId         String?
  chave               String
  valor               String
  modo                ModoValidacao?
  fundamentoNormaId   String?
  fundamentoDescricao String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  exercicio       Exercicio?          @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  fundamentoNorma DocumentoNormativo? @relation(fields: [fundamentoNormaId], references: [id], onDelete: SetNull)

  @@unique([exercicioId, chave])
  @@index([escopo])
  @@index([exercicioId])
}

// ============================================================================
// EMENDAS PARLAMENTARES
// ============================================================================

// Beneficiário final da emenda (órgão público ou entidade). Entidade global —
// a mesma instituição atravessa exercícios. CNPJ opcional (órgãos públicos).
model Beneficiario {
  id         String           @id @default(cuid())
  nome       String
  tipo       TipoBeneficiario @default(ADMINISTRACAO_DIRETA)
  cnpj       String?
  observacao String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  emendas Emenda[]

  @@unique([nome])
  @@index([tipo])
}

// Autor da emenda (vereador). Vínculo opcional a um usuário do sistema (1:1).
model Autor {
  id        String   @id @default(cuid())
  nome      String
  cargo     String
  usuarioId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  emendas Emenda[]

  @@index([usuarioId])
}

// Emenda: apresentada sobre o PROJETO_LEI base, referencia uma Dotacao existente.
// `objeto` é o campo narrativo livre (além de justificativa).
model Emenda {
  id                String       @id @default(cuid())
  numero            String
  exercicioId       String
  instrumentoBaseId String
  autorId           String
  dotacaoId         String
  tipo              TipoEmenda
  objeto            String
  justificativa     String
  valor             Decimal      @db.Decimal(18, 2)
  status            StatusEmenda @default(RASCUNHO)
  // Beneficiário final (rastreabilidade ponta a ponta — STF/TCE).
  beneficiarioId    String?
  // Para REMANEJAMENTO: origem e destino.
  dotacaoOrigemId   String?
  dotacaoDestinoId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  exercicio       Exercicio               @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  instrumentoBase InstrumentoPlanejamento @relation(fields: [instrumentoBaseId], references: [id])
  autor           Autor                   @relation(fields: [autorId], references: [id])
  beneficiario    Beneficiario?           @relation(fields: [beneficiarioId], references: [id], onDelete: SetNull)
  dotacao         Dotacao                 @relation("EmendaDotacao", fields: [dotacaoId], references: [id])
  dotacaoOrigem   Dotacao?                @relation("EmendaDotacaoOrigem", fields: [dotacaoOrigemId], references: [id])
  dotacaoDestino  Dotacao?                @relation("EmendaDotacaoDestino", fields: [dotacaoDestinoId], references: [id])
  validacoes      ValidacaoEmenda[]
  planoTrabalho   PlanoTrabalho?
  pareceres       ParecerViabilidade[]
  andamentos      AndamentoExecucao[]

  // Regra estrutural: dotacaoId e instrumentoBaseId obrigatórios e do mesmo
  // exercício (coerência de exercício é reforçada no motor/API — PROMPT 5/6).
  @@unique([exercicioId, numero])
  @@index([exercicioId])
  @@index([instrumentoBaseId])
  @@index([autorId])
  @@index([dotacaoId])
  @@index([status])
  @@index([beneficiarioId])
}

// Registro de uma execução do motor de validação sobre uma emenda.
model ValidacaoEmenda {
  id          String             @id @default(cuid())
  emendaId    String
  resultado   ResultadoValidacao
  executadaEm DateTime           @default(now())
  itens       Json

  emenda Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)

  @@index([emendaId])
  @@index([executadaEm])
}

// ============================================================================
// PARTICIPAÇÃO DO EXECUTIVO — viabilidade técnica e execução orçamentária
// ============================================================================

// Parecer de viabilidade técnica do Executivo sobre uma emenda.
//
// INFORMATIVO, NÃO BLOQUEANTE: registra a manifestação sem alterar a emenda e
// sem travar a tramitação — a Comissão decide vendo o parecer, não presa a ele.
// Disponível da submissão em diante, o que o faz servir aos dois momentos: como
// subsídio à Comissão antes da votação e como impedimento técnico depois de
// aprovada (CF art. 166 §11). O histórico é preservado: vale o mais recente.
model ParecerViabilidade {
  id            String               @id @default(cuid())
  emendaId      String
  resultado     ResultadoViabilidade
  justificativa String
  usuarioId     String?
  criadoEm      DateTime             @default(now())

  emenda  Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)
  usuario User?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([emendaId])
  @@index([criadoEm])
}

// Andamento da execução orçamentária de uma emenda, lançado pelo Executivo.
//
// Uma linha por etapa da despesa (empenho, liquidação, pagamento), com data,
// valor e número do documento. Lançamento manual nesta versão; os campos seguem
// o vocabulário da Lei 4.320/1964 para que uma integração futura com o sistema
// financeiro do município substitua a digitação sem trocar o modelo.
model AndamentoExecucao {
  id              String        @id @default(cuid())
  emendaId        String
  etapa           EtapaExecucao
  data            DateTime
  valor           Decimal       @db.Decimal(18, 2)
  numeroDocumento String?
  observacao      String?
  usuarioId       String?
  criadoEm        DateTime      @default(now())

  emenda  Emenda @relation(fields: [emendaId], references: [id], onDelete: Cascade)
  usuario User?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([emendaId])
  @@index([etapa])
  @@index([data])
}

// ============================================================================
// ACESSO E AUDITORIA — Auth.js (modelos técnicos em inglês) + AuditLog
// ============================================================================

// Usuário do sistema. Modelo `User` por exigência do @auth/prisma-adapter.
// Campos de domínio: poder, role, passwordHash (credenciais — PROMPT 9) e o
// vínculo opcional a Autor (back-relation do 1:1).
// Perfil de acesso — substitui o enum fixo de papéis (PROMPT 12). O Administrador
// Geral compõe perfis novos pela interface, sem alteração de código: o perfil é
// a combinação de um Poder de atuação com as permissões atômicas abaixo.
//
// `poder` nulo = transversal (atravessa os dois Poderes).
// `perfilDoSistema` marca os 5 perfis base, que não podem ser excluídos.
// `adminGeral` ignora todas as verificações — é o único que gere perfis.
model PerfilAcesso {
  id        String  @id @default(cuid())
  nome      String  @unique
  descricao String?
  poder     Poder?

  // Permissões atômicas. Um perfil sem nenhuma delas é perfil de consulta:
  // enxerga painéis e relatórios do seu Poder, sem botões de ação.
  apresentarEmendas        Boolean @default(false)
  gerirTodasEmendas        Boolean @default(false)
  tramitarEmendas          Boolean @default(false)
  gerirPlanejamento        Boolean @default(false)
  gerirExercicios          Boolean @default(false)
  administrarConfiguracoes Boolean @default(false)
  analisarViabilidade      Boolean @default(false)
  registrarExecucao        Boolean @default(false)

  perfilDoSistema Boolean @default(false)
  adminGeral      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios User[]

  @@index([poder])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  poder         Poder?
  // Sem perfil o usuário NÃO acessa o sistema: é devolvido ao login com aviso.
  perfilId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  perfil     PerfilAcesso?        @relation(fields: [perfilId], references: [id], onDelete: SetNull)
  accounts   Account[]
  sessions   Session[]
  autor      Autor?
  auditLogs  AuditLog[]
  pareceres  ParecerViabilidade[]
  andamentos AndamentoExecucao[]

  @@index([perfilId])
  @@index([poder])
}

// Auth.js — conta de provedor externo (OAuth) ligada ao usuário.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js — sessão persistida.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Auth.js — token de verificação (magic links / e-mail).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Trilha de auditoria: toda mutação relevante grava antes/depois.
model AuditLog {
  id          String   @id @default(cuid())
  usuarioId   String?
  entidade    String
  entidadeId  String
  acao        String
  dadosAntes  Json?
  dadosDepois Json?
  criadoEm    DateTime @default(now())

  usuario User? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
}

// ============================================================================
// Plano de trabalho SIMPLIFICADO.
//
// Não é o plano de trabalho do MROSC (Lei 13.019/2014). Aquele — com metas no
// formato Audesp, matriz de indicadores, memória de cálculo de RH, rateio e
// cronograma de desembolso — é elaborado depois, na execução orçamentária,
// quando o município for de fato repassar o recurso à entidade.
//
// O que entra aqui, na apresentação da emenda, é o mínimo que o jurídico do
// cliente definiu:
//   · terceiro setor → justificativa + objetivo + declaração + planilha
//   · administração direta e indireta → só a justificativa
// ============================================================================

model PlanoTrabalho {
  id       String @id @default(cuid())
  emendaId String @unique

  justificativa    String  @default("")
  objetivo         String  @default("")
  // Declaração de que a entidade atende aos requisitos para receber repasse
  // público. Só se aplica ao terceiro setor.
  declaracaoAceita Boolean @default(false)

  // Preenchimento pela própria entidade, sem conta no sistema: o vereador gera
  // um link e envia. Token nulo = nunca foi compartilhado.
  token         String?   @unique
  tokenExpiraEm DateTime?
  preenchidoPor String?
  preenchidoEm  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emenda Emenda              @relation(fields: [emendaId], references: [id], onDelete: Cascade)
  itens  ItemPlanoTrabalho[]

  @@index([token])
}

// Linha da planilha orçamentária. O total é derivado (quantidade × unitário) —
// guardar o produto seria abrir espaço para os dois discordarem.
model ItemPlanoTrabalho {
  id            String  @id @default(cuid())
  planoId       String
  ordem         Int     @default(0)
  descricao     String
  quantidade    Decimal @db.Decimal(18, 4)
  valorUnitario Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plano PlanoTrabalho @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@index([planoId])
}
